      "path": "outputs/liquid_plain_target_v3/summary.json",
      "nested": [],
      "fields": {
        "macro_accuracy": "question_macro_accuracy",
        "pooled_accuracy": "pooled_accuracy",
        "invalid_outputs": "invalid_outputs",
        "majority_macro_accuracy": "majority_macro_accuracy"
      },
      "scope": "9 binary QIDs, fixed validation C"
